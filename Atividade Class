import java.util.Scanner;

class Produto {
    String titulo;
    String descricao;
    double precoUnitario;
    int qtdEstoque;
}

public class Main {
    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);

        for (int i = 1; i <= 2; i++) {
            Produto p = new Produto();

            System.out.println("Digite os dados do produto " + i);
            System.out.print("Título: ");
            p.titulo = teclado.nextLine();
            System.out.print("Descrição: ");
            p.descricao = teclado.nextLine();
            System.out.print("Preço unitário: ");
            p.precoUnitario = Double.parseDouble(teclado.nextLine());
            System.out.print("Quantidade em estoque: ");
            p.qtdEstoque = Integer.parseInt(teclado.nextLine());

            System.out.println("--- Produto " + i + " ---");
            System.out.println("Título: " + p.titulo);
            System.out.println("Descrição: " + p.descricao);
            System.out.println("Preço unitário: " + p.precoUnitario);
            System.out.println("Quantidade em estoque: " + p.qtdEstoque);
        }
    }
}
